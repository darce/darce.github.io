{
  "$description": "Shared portfolio layout, spacing, and article typography. DTCG Format Module 2025.10.",
  "spacing": {
    "$type": "dimension",
    "base": { "$value": { "value": 2, "unit": "px" } },
    "small": { "$value": { "value": 6, "unit": "px" } },
    "medium": { "$value": { "value": 12, "unit": "px" } },
    "large": { "$value": { "value": 24, "unit": "px" } },
    "x-large": { "$value": { "value": 48, "unit": "px" } },
    "line": { "$value": { "value": 1, "unit": "px" } }
  },
  "breakpoint": {
    "$type": "dimension",
    "mobile-end": { "$value": { "value": 768, "unit": "px" } },
    "tablet-end": { "$value": { "value": 1024, "unit": "px" } }
  },
  "layout": {
    "rail": {
      "minimum": { "$type": "dimension", "$value": { "value": 18, "unit": "rem" } },
      "viewport-share": { "$type": "number", "$value": 0.28, "$description": "Fraction of viewport width; the web consumer multiplies by 100vw." },
      "maximum": { "$type": "dimension", "$value": { "value": 24, "unit": "rem" } }
    }
  },
  "article": {
    "measure-characters": { "$type": "number", "$value": 72, "$description": "Standalone monospaced prose measure, not article or media width; the web consumer multiplies by 1ch." },
    "inset": {
      "minimum-container": { "$type": "dimension", "$value": { "value": 42, "unit": "rem" }, "$description": "Only wrap prose when the actual full article canvas has this much space." },
      "width-share": { "$type": "number", "$value": 0.5, "$description": "Fraction of the full article canvas used by a desktop inset figure." },
      "gutter": { "$type": "dimension", "$value": "{spacing.large}" }
    },
    "viewer": {
      "edge": { "$type": "dimension", "$value": "{spacing.medium}" },
      "padding": { "$type": "dimension", "$value": "{spacing.medium}" },
      "control-size": { "$type": "dimension", "$value": { "value": 2.75, "unit": "rem" } },
      "zoom-factor": { "$type": "number", "$value": 2 }
    }
  },
  "typography": {
    "body": {
      "line-height": { "$type": "number", "$value": 1.65 }
    },
    "caption": {
      "size": { "$type": "dimension", "$value": { "value": 0.875, "unit": "rem" } },
      "line-height": { "$type": "number", "$value": 1.5 }
    },
    "article-title": {
      "size": { "$type": "dimension", "$value": { "value": 2, "unit": "rem" } },
      "mobile-size": { "$type": "dimension", "$value": { "value": 1.2, "unit": "rem" } },
      "line-height": { "$type": "number", "$value": 1.25 },
      "mobile-line-height": { "$type": "number", "$value": 1.3 },
      "measure-ems": { "$type": "number", "$value": 24 }
    },
    "h2": {
      "size": { "$type": "dimension", "$value": { "value": 1.4, "unit": "rem" } },
      "mobile-size": { "$type": "dimension", "$value": { "value": 1.2, "unit": "rem" } },
      "line-height": { "$type": "number", "$value": 1.3 },
      "weight": { "$type": "number", "$value": 650, "$description": "Variable-font wght axis." }
    },
    "h3": {
      "size": { "$type": "dimension", "$value": { "value": 1.05, "unit": "rem" } },
      "line-height": { "$type": "number", "$value": 1.4 },
      "weight": { "$type": "number", "$value": 600, "$description": "Variable-font wght axis." }
    },
    "page-title-rhythm": {
      "$type": "dimension",
      "desktop": { "$value": { "value": 3, "unit": "rem" } },
      "mobile": { "$value": { "value": 1.3, "unit": "rem" } }
    }
  }
}
