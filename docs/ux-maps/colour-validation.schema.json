{
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "findings", "cited_ids", "summary"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["accept", "accept-with-edits", "refuse"]
    },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "rule_ids", "claim", "edit"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["block", "should", "note"] },
          "rule_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "claim": { "type": "string" },
          "edit": { "type": "string" }
        }
      }
    },
    "cited_ids": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
