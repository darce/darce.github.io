{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "target": "es2022"
  },
  "include": [
    "next-env.d.ts",
    "test/**/*.ts",
    "test/**/*.tsx",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "agentic",
    "out",
    ".next"
  ]
}
